{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/founder",
      "destination": "/founder/index.html"
    },
    {
      "source": "/company",
      "destination": "/company/index.html"
    },
    {
      "source": "/domains/software",
      "destination": "/domains/software/index.html"
    },
    {
      "source": "/vortex",
      "destination": "/vortex/index.html"
    },
    {
      "source": "/pragya",
      "destination": "/pragya/index.html"
    },
    {
      "source": "/technologies",
      "destination": "/technologies/index.html"
    },
    {
      "source": "/technologies/autonomous-systems",
      "destination": "/technologies/autonomous-systems/index.html"
    },
    {
      "source": "/technologies/aerospace-technologies",
      "destination": "/technologies/aerospace-technologies/index.html"
    },
    {
      "source": "/technologies/artificial-intelligence",
      "destination": "/technologies/artificial-intelligence/index.html"
    },
    {
      "source": "/technologies/advanced-robotics",
      "destination": "/technologies/advanced-robotics/index.html"
    },
    {
      "source": "/capabilities",
      "destination": "/capabilities/index.html"
    },
    {
      "source": "/research",
      "destination": "/research/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/doccumentation",
      "destination": "/doccumentation/index.html"
    },
    {
      "source": "/domains/air",
      "destination": "/domains/air/index.html"
    },
    {
      "source": "/domains/land",
      "destination": "/domains/land/index.html"
    },
    {
      "source": "/domains/sea",
      "destination": "/domains/sea/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/technologies/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/research/pluto",
      "destination": "/research/pluto/index.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/domains/:domain",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/products",
      "destination": "/domains/software",
      "permanent": true
    },
    {
      "source": "/documentation",
      "destination": "/doccumentation",
      "permanent": true
    },
    {
      "source": "/research/aether",
      "destination": "/research/pluto",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
